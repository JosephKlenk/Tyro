.todoListContainer {
  background-color: #f5f5f5;
  border-radius: 10px;
  padding: 20px;
  width: 100%;
  max-width: 800px;
  margin: 0 auto;
}

.todoTitle {
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 20px;
}

.todoItem {
  display: flex;
  align-items: center;
  margin-bottom: 5px;
}

.todoCheckbox {
  margin-right: 10px;
}

.completed {
  text-decoration: line-through;
  color: gray;
}

.deleteButton {
  background-color: transparent;
  border: none;
  font-size: 16px;
  font-weight: bold;
  color: #ff4f4f;
  margin-left: 10px;
  cursor: pointer;
}

.deleteButton:hover {
  opacity: 0.8;
}
